#!/usr/bin/expect -f
# vmsh <cmd...> — VM(admin/admin) 안에서 명령 실행 · 호스트 known_hosts 무오염
set timeout [expr {[info exists env(VMSH_TIMEOUT)] ? $env(VMSH_TIMEOUT) : 120}]
set ip $env(VMIP)
set cmd [join $argv " "]
log_user 1
spawn -noecho ssh -q -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive admin@$ip $cmd
expect {
  -re "(?i)password:" { send "admin\r"; exp_continue }
  eof
}
catch wait result
exit [lindex $result 3]
