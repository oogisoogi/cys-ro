{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cysr",
  "version": "1.0.2",
  "identifier": "com.cysjavis.terminal",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "sh ../scripts/bundle-prep.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "cysr — CYSJavis Terminal",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/cysd",
      "binaries/cys"
    ],
    "resources": {
      "resources/pack.tar.gz": "./",
      "resources/pack-manifest.json": "./",
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMUNBOTE3MjIwNEU5M0UKUldRKzZRUWlGNmtjZzZKdWluYWlzUytJM3RLUUIrcjJhbjRnYTFCVUt0S0RRd2cwL2NvMjJDd3QK",
      "endpoints": [
        "https://github.com/oogisoogi/cys-ro/releases/latest/download/latest.json"
      ]
    }
  }
}
